# Environment variables for crosslist-dashboard MVP
# Copy this file to .env and fill in real values. Never commit .env.
#
# Vercel: add these in Project Settings → Environment Variables.
# After the first deploy, set BASE_URL to https://<your-app>.vercel.app
# and update every OAuth redirect URI to that same origin.
#
# POSTING ARCHITECTURE: every store posts through the Crosslist Connector
# Chrome extension (the user's logged-in browser session) — no store API
# credentials are needed for posting. API variables below exist only for
# read paths: eBay sold comps (photo pricing), eBay/Etsy/Reverb imports.

# eBay: EBAY_CLIENT_ID/SECRET power the sold-comps pricing (Buy Browse API)
# and the eBay OAuth app; EBAY_REDIRECT_URI is used by eBay import.
# (https://developer.ebay.com/my/keys)
# Production so official app credentials can use Google SSO on eBay's sign-in page.
# Set EBAY_USE_PRODUCTION=false only for sandbox test users.
EBAY_USE_PRODUCTION=true
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_AUTH_BASE_URL=https://auth.ebay.com
EBAY_BASE_URL=https://api.ebay.com
# RuName from eBay Developer → Your eBay Sign-in Settings (not a URL).
# Register http://localhost:3000/api/auth/ebay/callback as that RuName's accepted URL.
EBAY_REDIRECT_URI=

# Facebook Marketplace has no public listing OAuth API.
# Connect it with the Chrome extension (extension/ folder).

# Depop posts through the Chrome extension (extension/ folder) — no API
# credentials are needed. (Depop OAuth client vars were removed: the app no
# longer posts to Depop via the partner API.)

# Etsy OAuth (https://www.etsy.com/developers/your-apps)
# Kept for Etsy IMPORT (read-only). Posting goes through the Chrome extension.
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=http://localhost:3000/api/auth/etsy/callback
ETSY_SCOPES=listings_r listings_w shops_r shops_w transactions_r

# Reverb Personal Access Token (https://reverb.com/my/api_settings)
# Note: Reverb OAuth is no longer available as of September 2026.
# Users connect their Reverb account by pasting a personal access token
# from https://reverb.com/my/api_settings in the app's Marketplaces page.
# No environment variables needed for Reverb.

# Photo intelligence — identifies the exact product (brand, model, size, color,
# condition) from listing photos and prices it from eBay sold comps.
# Get a key at https://platform.openai.com/api-keys, or point VISION_BASE_URL
# at any OpenAI-compatible vision gateway.
# Without VISION_API_KEY, photo identification is unavailable (the app shows a
# clear setup error instead of guessing). Sold comps reuse EBAY_CLIENT_ID /
# EBAY_CLIENT_SECRET below via eBay's read-only app credentials.
VISION_PROVIDER=openai
VISION_API_KEY=
# Optional overrides (defaults: gpt-4o-mini, provider default base URL).
# VISION_MODEL=
# VISION_BASE_URL=

# Google sign-in (https://console.cloud.google.com/apis/credentials)
# Vercel: set GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, BASE_URL, and SESSION_SECRET
# in Project Settings. Leave GOOGLE_REDIRECT_URI unset on Vercel (this localhost
# value is for local dev only). In Google Cloud, add:
#   https://<your-app>.vercel.app/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Server configuration
PORT=3000
NODE_ENV=development

# Public URL used to build OAuth redirect URIs.
# Local: http://localhost:3000
# Vercel: https://your-app.vercel.app (or your custom domain)
BASE_URL=http://localhost:3000

# Signs cookies and OAuth state. Use a long random string on Vercel.
SESSION_SECRET=

# Vendoo server configuration
VENDOO_SERVER_ENDPOINT=http://localhost:3001
