# Environment variables for crosslist-dashboard MVP
# Copy this file to .env and fill in real values. Never commit .env.
#
# Vercel: add these in Project Settings → Environment Variables.
# After the first deploy, set BASE_URL to https://<your-app>.vercel.app
# and update every OAuth redirect URI to that same origin.

# eBay OAuth (https://developer.ebay.com/my/keys)
# Production so official app credentials can use Google SSO on eBay's sign-in page.
# Set EBAY_USE_PRODUCTION=false only for sandbox test users.
EBAY_USE_PRODUCTION=true
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_AUTH_BASE_URL=https://auth.ebay.com
EBAY_BASE_URL=https://api.ebay.com
EBAY_REDIRECT_URI=http://localhost:3000/api/auth/ebay/callback

# Facebook Marketplace has no public listing OAuth API.
# Connect it with the Chrome extension (extension/ folder).

# Depop OAuth (https://partnerapi.depop.com/api-docs/)
DEPOP_CLIENT_ID=
DEPOP_CLIENT_SECRET=
DEPOP_AUTH_URL=https://www.depop.com/settings/oauth/apps/
DEPOP_TOKEN_URL=https://partnerapi.depop.com/api/v1/oauth2/access-token/
DEPOP_REDIRECT_URI=http://localhost:3000/api/auth/depop/callback
DEPOP_SCOPES=products_read products_write shop_read orders_read

# Etsy OAuth (https://www.etsy.com/developers/your-apps)
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_REDIRECT_URI=http://localhost:3000/api/auth/etsy/callback
ETSY_SCOPES=listings_r listings_w shops_r shops_w transactions_r

# Google sign-in (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Server configuration
PORT=3000
NODE_ENV=development

# Public URL used to build OAuth redirect URIs.
# Local: http://localhost:3000
# Vercel: https://your-app.vercel.app (or your custom domain)
BASE_URL=http://localhost:3000

# Vendoo server configuration
VENDOO_SERVER_ENDPOINT=http://localhost:3001
